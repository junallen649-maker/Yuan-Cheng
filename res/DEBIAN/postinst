#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	if [ -e /usr/share/polaris/polaris ]; then
		ln -f -s /usr/share/polaris/polaris /usr/bin/polaris
	fi
	ln -f -s /usr/share/rustdesk/rustdesk /usr/bin/rustdesk 2>/dev/null || true

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/rustdesk.service ]; then
			rm -f /etc/systemd/system/rustdesk.service /usr/lib/systemd/system/rustdesk.service /usr/lib/systemd/user/rustdesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		if [ -e /usr/share/polaris/files/systemd/polaris.service ]; then
			cp /usr/share/polaris/files/systemd/polaris.service /usr/lib/systemd/system/polaris.service
			systemctl daemon-reload
			systemctl enable polaris || true
			systemctl start polaris || true
		elif [ -e /usr/share/rustdesk/files/systemd/rustdesk.service ]; then
			cp /usr/share/rustdesk/files/systemd/rustdesk.service /usr/lib/systemd/system/rustdesk.service
			if [ -e /usr/bin/pkill ]; then
				sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/rustdesk.service
			fi
			systemctl daemon-reload
			systemctl enable rustdesk || true
			systemctl start rustdesk || true
		fi
	fi
fi
